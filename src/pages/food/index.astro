---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { foodItems } from "../../data/food";
import { foodGuides } from "../../data/foodGuides";
import { faqSchema } from "../../utils/schema";
const groups = ["早餐","午餐","下午茶","晚餐"];
const foodFaqs: [string, string][] = [
  ["北港老街美食有哪些？", "北港老街以朝天宮廟口的中山路為核心，常見品項有煎盤粿、麵線糊、土豆油飯、鴨肉飯、假魚肚、花生、麻荖、傳統漢餅與麻油料理。建議按時段挑選，而不是只追逐單一名單。"],
  ["北港早餐推薦吃什麼？", "早餐首推煎盤粿、麵線糊與土豆油飯，多為早場。建議 07:00–09:00 抵達，熱門店家可能上午就售完，先吃早餐再開始逛。"],
  ["北港老街晚上吃什麼（宵夜）？", "老街不是每日夜市，傍晚後傳統小吃陸續打烊。晚餐可找鴨肉飯、麻油料理，或把範圍擴大到華南路、文化路周邊餐館，出發前先確認當日營業。"],
  ["朝天宮附近有什麼好吃的？", "廟口步行圈內有小吃、鴨肉飯、羹湯與甜點，店家各有營業時段，建議搭配本站的美食時段規劃，避開尖峰更從容。"],
  ["北港伴手禮在哪裡買？", "麻油、花生、麻荖與傳統漢餅集中在中山路老街步行圈，可參考本站伴手禮指南，先試小包裝再決定是否買禮盒。"],
  ["北港美食的營業時間可靠嗎？", "本站只記錄常見時段與售完提醒，不根據一般營業時間顯示「營業中」。店休、售完與節慶備料都可能發生，若只為一間店前往，請直接查店家當日公告。"],
];
---
<BaseLayout title="北港老街美食地圖｜早餐、鴨肉飯、宵夜與伴手禮推薦" description="北港老街吃什麼？按早餐、午餐、下午茶、宵夜整理在地小吃與伴手禮，附營業時段與售完提醒，第一次來也能吃對時間。" schema={faqSchema(foodFaqs)}>
  <PageHero title="北港美食" eyebrow="EAT IN BEIGANG" description="不做沒有來源的必吃排名。按照時間、份量和行程來選，吃得到比排得多更重要。" tone="gold" breadcrumbs={[{label:"首頁",href:"/"},{label:"美食"}]}/>
  <section class="section"><div class="container"><nav class="food-nav" aria-label="美食主題">{foodGuides.map(g=><a href={`/food/${g.slug}/`}>{g.title}</a>)}</nav>{groups.map(group => { const items=foodItems.filter(item=>item.category===group); return <section class="food-group"><header><span>{group === "早餐" ? "07—10" : group === "午餐" ? "11—14" : group === "下午茶" ? "14—17" : "17—LATE"}</span><h2>{group}</h2><p>{group === "早餐" ? "早到是最重要的攻略" : group === "午餐" ? "避開 12 點尖峰會更從容" : group === "下午茶" ? "邊散步邊安排伴手禮" : "把範圍擴大，不只看老街"}</p></header><div class="food-cards">{items.map(item=><article><div><span>{item.style}</span><strong>{item.budget}</strong></div><h3>{item.name}</h3><p>{item.description}</p><dl><div><dt>常見時段</dt><dd>{item.time}</dd></div><div><dt>用餐方式</dt><dd>{item.dine}</dd></div><div><dt>售完提醒</dt><dd>{item.soldOut}</dd></div><div><dt>位置</dt><dd>{item.walk}</dd></div></dl><small>{item.verified}</small></article>)}</div></section>})}<div class="principle"><div><span>OUR RULE</span><h2>不引用評分，不虛構「在地人都推薦」</h2></div><p>我們記錄品項、時段、預算、用餐方式和資料限制。店家營業與售完時間仍以當日現場為準。</p></div></div></section>
  <section class="section food-faq"><div class="container"><div class="section-heading"><p class="eyebrow">BEFORE YOU EAT</p><h2>北港美食常見問題</h2><p>出發前先把吃的時間想好，比臨時找店更順。</p></div><div class="faq-list">{foodFaqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{String(index + 1).padStart(2, "0")}</span>{question}<i>＋</i></summary><p>{answer}</p></details>)}</div></div></section>
</BaseLayout>
<style>.food-nav{display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:4rem}.food-nav a{padding:.5rem .8rem;border:1px solid var(--border);border-radius:999px;font-size:.78rem;font-weight:800;text-decoration:none;background:var(--surface)}.food-group{display:grid;grid-template-columns:220px 1fr;gap:2rem;padding:3rem 0;border-top:1px solid var(--border)}.food-group>header{position:sticky;top:7rem;align-self:start}.food-group header>span{color:var(--red);font-size:.7rem;font-weight:900;letter-spacing:.15em}.food-group h2{margin:.4rem 0}.food-group header p{color:var(--muted);font-size:.8rem}.food-cards{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.food-cards article{padding:1.2rem;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--surface)}.food-cards article>div{display:flex;justify-content:space-between;color:var(--red);font-size:.68rem;font-weight:900}.food-cards h3{margin:.55rem 0}.food-cards>article>p{min-height:74px;color:var(--muted);font-size:.82rem}.food-cards dl{margin-top:1rem;border-top:1px solid var(--border)}.food-cards dl div{display:grid;grid-template-columns:5.5rem 1fr;padding:.35rem 0;border-bottom:1px dashed var(--border);font-size:.7rem}.food-cards dt{color:var(--muted)}.food-cards dd{margin:0;font-weight:700}.food-cards article>small{display:block;margin-top:.7rem;color:var(--green);font-size:.65rem}.principle{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:3rem;margin-top:3rem;padding:2rem;border-radius:var(--radius-md);color:white;background:var(--red)}.principle span{color:var(--gold-light);font-size:.68rem;font-weight:900}.principle h2{margin-top:.4rem}.principle p{color:rgba(255,255,255,.8)}@media(max-width:820px){.food-group{grid-template-columns:1fr}.food-group>header{position:static}.food-cards{grid-template-columns:1fr 1fr}}@media(max-width:620px){.food-cards,.principle{grid-template-columns:1fr}.food-cards>article>p{min-height:0}.principle{gap:1rem}}
.food-faq .section-heading{margin-bottom:1.5rem}.food-faq .section-heading p{color:var(--muted);font-size:.92rem}.food-faq .faq-list{border-top:1px solid var(--border)}.food-faq .faq-list details{border-bottom:1px solid var(--border)}.food-faq .faq-list summary{display:grid;grid-template-columns:2.5rem 1fr auto;min-height:72px;align-items:center;gap:1rem;cursor:pointer;font-family:var(--serif);font-size:1.06rem;font-weight:800;list-style:none}.food-faq .faq-list summary::-webkit-details-marker{display:none}.food-faq .faq-list summary span{color:var(--red);font-family:var(--sans);font-size:.7rem}.food-faq .faq-list summary i{color:var(--gold);font-style:normal;transition:transform .2s}.food-faq .faq-list details[open] summary i{transform:rotate(45deg)}.food-faq .faq-list details p{padding:0 2rem 1.4rem 3.5rem;color:var(--muted);font-size:.9rem}</style>
