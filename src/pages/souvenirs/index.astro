---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { souvenirGuides } from "../../data/souvenirs";
import { faqSchema } from "../../utils/schema";
const souvenirFaqs: [string, string][] = [
  ["北港伴手禮必買什麼？", "北港老街最具代表性的伴手禮是麻油、花生與花生糖、麻荖，以及漢餅等傳統糕餅。建議先試小包裝，再決定是否買禮盒送人。"],
  ["北港麻油怎麼挑？", "先看原料與製程（黑麻油、香油用途不同）、容量與保存標示；不以顏色深淺單獨判斷品質，長途攜帶也要確認瓶口與包裝。"],
  ["北港花生會過敏嗎？", "花生與相關點心含堅果過敏原，購買前務必確認；夏季不要長時間放在高溫車內，保存期限與密封方式也要看清楚。"],
  ["伴手禮可以宅配或指定取貨嗎？", "大量採買先問店家提貨與宅配安排，節慶前後熱門品項與禮盒預訂量大，現貨與取貨時間要提前確認。"],
  ["北港傳統糕餅推薦？", "漢餅、麻荖與喜餅店集中在老街步行圈，先分清現吃小包裝與送禮盒裝，並詢問葷素、蛋奶與過敏原。"],
];
---
<BaseLayout title="北港老街伴手禮推薦｜麻油、花生、麻荖與傳統漢餅" description="北港老街伴手禮買什麼？整理麻油、花生、麻荖與傳統漢餅的選購重點、保存方式與過敏原提醒，送禮自用不踩雷。" schema={faqSchema(souvenirFaqs)}><PageHero title="北港伴手禮" eyebrow="TAKE BEIGANG HOME" description="不急著買最大盒。先試味道、看保存，再把北港的麻油香、花生與糕餅帶回家。" tone="gold" breadcrumbs={[{label:"首頁",href:"/"},{label:"伴手禮"}]}/><section class="section"><div class="container"><div class="gift-grid">{souvenirGuides.map((guide,index)=><a href={`/souvenirs/${guide.slug}/`}><span>{String(index+1).padStart(2,"0")}</span><small>{guide.eyebrow}</small><h2>{guide.title}</h2><p>{guide.description}</p><i>查看選購提醒 →</i></a>)}</div><div class="gift-note"><h2>買伴手禮的四個問題</h2><ol><li>今天吃還是送人？</li><li>要帶多久、需不需要冷藏？</li><li>有沒有花生、芝麻、蛋奶等過敏原？</li><li>大量購買能否宅配或指定取貨？</li></ol></div></div></section>
  <section class="section gift-faq"><div class="container"><div class="section-heading"><p class="eyebrow">BEFORE YOU BUY</p><h2>北港伴手禮常見問題</h2><p>先想清楚送誰、帶多久，再決定買什麼。</p></div><div class="faq-list">{souvenirFaqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{String(index + 1).padStart(2, "0")}</span>{question}<i>＋</i></summary><p>{answer}</p></details>)}</div></div></section>
</BaseLayout>
<style>.gift-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.gift-grid a{display:flex;min-height:350px;padding:1.4rem;border:1px solid var(--border);border-radius:var(--radius-md);color:var(--ink);background:var(--surface);flex-direction:column;text-decoration:none}.gift-grid a:hover{color:var(--ink);box-shadow:var(--shadow-lg)}.gift-grid span{color:var(--gold);font-family:var(--serif)}.gift-grid small{margin-top:2rem;color:var(--red);font-weight:900}.gift-grid h2{margin:.5rem 0;font-size:1.5rem}.gift-grid p{color:var(--muted);font-size:.84rem}.gift-grid i{margin-top:auto;color:var(--red);font-style:normal;font-size:.78rem;font-weight:900}.gift-note{display:grid;grid-template-columns:1fr 1fr;gap:3rem;margin-top:3rem;padding:2rem;border-radius:var(--radius-md);color:white;background:var(--green)}.gift-note ol{padding-left:1.2rem;color:rgba(255,255,255,.8);font-size:.85rem}@media(max-width:760px){.gift-grid{grid-template-columns:1fr}.gift-grid a{min-height:250px}.gift-note{grid-template-columns:1fr;gap:1rem}}
.gift-faq .section-heading{margin-bottom:1.5rem}.gift-faq .section-heading p{color:var(--muted);font-size:.92rem}.gift-faq .faq-list{border-top:1px solid var(--border)}.gift-faq .faq-list details{border-bottom:1px solid var(--border)}.gift-faq .faq-list summary{display:grid;grid-template-columns:2.5rem 1fr auto;min-height:72px;align-items:center;gap:1rem;cursor:pointer;font-family:var(--serif);font-size:1.06rem;font-weight:800;list-style:none}.gift-faq .faq-list summary::-webkit-details-marker{display:none}.gift-faq .faq-list summary span{color:var(--red);font-family:var(--sans);font-size:.7rem}.gift-faq .faq-list summary i{color:var(--gold);font-style:normal;transition:transform .2s}.gift-faq .faq-list details[open] summary i{transform:rotate(45deg)}.gift-faq .faq-list details p{padding:0 2rem 1.4rem 3.5rem;color:var(--muted);font-size:.9rem}</style>
